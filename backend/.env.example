GEMINI_API_KEY=
# optional
GEMINI_MODEL=gemini-2.5-flash
ADVISOR_LLM=on   # set to off to force the offline extractor

# Text to speech (Azure AI Speech). Both values are on the Speech resource page in the Azure portal.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Accounts and back-office
# UDYVIA_DB=var/udyvia.db            # SQLite file (created on first start, owner-only permissions)
# COOKIE_SECURE=1                    # set to 1 when served over HTTPS
# BACKOFFICE_EMAIL=staff@example.com # creates/refreshes a back-office login on startup (or: python -m app.staff EMAIL PASSWORD)
# BACKOFFICE_PASSWORD=               # 10+ characters
